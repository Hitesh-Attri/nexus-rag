# Neon Postgres — direct connection, SSL required. Copy to .env and fill DATABASE_URL.
# .env is gitignored; never commit real credentials.
DATABASE_URL=

# Resilient LLM gateway (run it locally on :8080 for the generation step in Step 6)
GATEWAY_URL=http://localhost:8080

# Embedding model (local, no key). 384-dim MUST match vector(384) in the DB.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Chunking (characters) + retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5